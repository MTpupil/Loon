#!name=CC‑Switch AI Provider 管理
#!desc=多AI服务商中转管理，支持动态添加/删除服务商，余额查询
#!author=MTpupil
#!icon=https://raw.githubusercontent.com/sub-store-org/Sub-Store/master/assets/icon.png
#!version=2.1.0
#!openUrl=http://boxjs.app/ccswitch_ai_provider

[Mitm]
hostname=boxjs.app,*.boxjs.app

[Script]
http-request ^https?:\/\/(.+\.)?boxjs\.app\/ccswitch_ai_provider script-path=https://cdn.jsdelivr.net/gh/MTpupil/Loon@main/Task/ccswitch.js,requires-body=true,timeout=30,tag=CC‑AI‑Provider
# 可选 cron
cron "*/5 * * * *" script-path=https://cdn.jsdelivr.net/gh/MTpupil/Loon@main/Task/ccswitch.js,tag=CC‑AI‑Provider‑Cron,enable=true